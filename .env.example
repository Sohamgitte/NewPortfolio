# =============================================================================
# SohamLabs Portfolio CMS - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and fill in your Supabase project credentials.
# NEVER commit your real '.env' file or expose your service_role secret key!
# =============================================================================

# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon / Public Key (Safe to expose on the client, protected by Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# Optional: Custom site URL for auth redirects (default: current window origin)
VITE_SITE_URL=https://sohamgitte.in
